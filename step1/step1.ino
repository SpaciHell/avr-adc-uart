#include <avr/interrupt.h>

void setup() {
  DDRB |= (1 << PB1);
  //используем таймер1,мигает раз в секунду, то есть прерывание каждые 0.5с
  TCCR1A = 0;
  TCCR1B = (1 << WGM12) | (1 << CS12); //режим СТС(4 режим) и делитель 256, поэтому предыдущая строчка 0
  OCR1A = 31249;
  TIMSK1 = (1 << OCIE1A); //прерывние при достижении значения OCR1A
  sei();
}

ISR(TIMER1_COMPA_vect) {
  PORTB ^= (1 << PB1); //переключение диода
}

void loop() {
}
